# BBB-MolGraph Environment Variables Template
# Copy this file to .env and configure local values as needed.
# DO NOT COMMIT .env TO VERSION CONTROL.

# Hugging Face Access Token (Optional: only needed if using gated repositories)
HF_TOKEN=

# Path to Cache Directory for Pretrained Weights (Optional: defaults to system cache)
BBB_CACHE_DIR=

# Device Configuration (e.g., 'cuda', 'cpu', 'cuda:0')
BBB_DEVICE=

# Random Seed for Reproducibility (Default: 42)
BBB_SEED=42
